{
  "name": "codecraft-vue3",
  "private": true,
  "version": "3.0.7",
  "type": "module",
  "description": "CodeCraft 桌面端前端（v3 骨架，逐层迁移自 v2）",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/clean-out.cjs && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "check:api": "node scripts/check-api-contract.cjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.3.3",
    "markdown-it-container": "^4.0.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vue-tsc": "^3.2.6"
  }
}
