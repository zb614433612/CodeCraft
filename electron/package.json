{
  "name": "codecraft-desktop",
  "version": "3.0.0",
  "description": "CodeCraft 桌面应用（Electron）",
  "homepage": "https://github.com/zb614433612/CodeCraft",
  "author": {
    "name": "CodeCraft",
    "email": "codecraft@example.com"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env DEV_MODE=true electron .",
    "pack": "npm install electron-builder && electron-builder --dir",
    "dist": "npm install electron-builder && electron-builder",
    "dist:win": "npm install electron-builder && electron-builder --win",
    "dist:mac": "npm install electron-builder && electron-builder --mac",
    "dist:linux": "npm install electron-builder && electron-builder --linux"
  },
  "build": {
    "appId": "com.codecraft.app",
    "productName": "CodeCraft",
    "directories": {
      "output": "release"
    },
    "afterPack": "afterPack.js",
    "files": [
      "main.js",
      "preload.js",
      "update-manager.js",
      "update-utils.js",
      "package.json",
      "icon.png",
      "loading.html"
    ],
    "extraResources": [
      {
        "from": "../target/code-craft-3.0.0.jar",
        "to": "backend/codecraft.jar"
      },
      {
        "from": "jre",
        "to": "jre",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "无需使用麦克风",
        "NSCameraUsageDescription": "无需使用摄像头"
      }
    },
    "dmg": {
      "title": "CodeCraft-${arch}",
      "icon": "icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "icon.png",
      "category": "Development",
      "maintainer": "codecraft@example.com"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "installer.nsh"
    }
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
