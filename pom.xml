<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.example</groupId>
    <artifactId>code-craft</artifactId>
    <version>3.0.3</version>
    <name>CodeCraft</name>
    <description>CodeCraft - AI Coding Assistant</description>
    <url/>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>17</java.version>
        <lombok.version>1.18.34</lombok.version>
        <springdoc.version>2.5.0</springdoc.version>
        <swagger.core.version>2.2.21</swagger.core.version>
        <!-- MCP Java SDK 版本（官方 modelcontextprotocol/java-sdk v2.0.0，跟踪 MCP 2025-11-25 规范） -->
        <mcp.version>2.0.0</mcp.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            前端构建开关（frontend-maven-plugin）。
            默认 false = 打包时自动构建**两套**前端：
              ① 经典版 frontend/    -> src/main/resources/static/     （访问 /）
              ② 新版   frontend-v3/ -> src/main/resources/v3-static/  （访问 /v3/）
            命令行 -DskipFrontend=true 可同时跳过两者（只编译后端、或前端已单独构建过时用）。

            注意：历史上这里只在 plugin 注释里写了「可用 -DskipFrontend 跳过」，
            但 plugin 一直没有 <skip> 配置，该参数是空操作 —— 每次 package 都会重建
            经典版前端，并顺手清空 src/main/resources/static（v3 曾因此被误删）。

            另一个历史坑：v3 的构建原先只写在 scripts/pack-v3.bat 里，CI 只跑
            `mvn clean package`，导致发布出去的安装包缺 v3 产物（/v3/ 404）。
            现在两套前端都在 pom 里构建，本地与 CI 走同一条链路。
        -->
        <skipFrontend>false</skipFrontend>
        <!--
            构建时间：application.yml 的 app.build-time 使用 @maven.build.timestamp@，
            由 spring-boot-starter-parent 的资源过滤（@ 分隔符）注入，供「版本与更新」页展示。
            实测注入值为 Maven 内置默认格式（ISO 8601 UTC，如 2026-10-19T09:23:34Z）——
            前端按本地时区格式化成 YYYY-MM-DD HH:mm 再显示，故这里不再自定义格式化属性。
        -->
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- Spring Boot Web Starter -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Lombok - 减少样板代码 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- SpringDoc OpenAPI - API文档生成 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <!-- Milvus Java SDK - 向量数据库连接 -->
        <dependency>
            <groupId>io.milvus</groupId>
            <artifactId>milvus-sdk-java</artifactId>
            <version>2.3.4</version>
        </dependency>
        <!-- H2 Database (内嵌数据库，替代 MySQL) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Phase 20：外部数据库连接（execute_sql 支持用户配置的业务库） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- MyBatis Spring Boot Starter -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>3.0.3</version>
        </dependency>
        <!-- Spring Boot WebFlux for streaming responses -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- Caffeine 本地缓存（替代 Redis） -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- Jsoup HTML解析库（web_fetch 用） -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.1</version>
        </dependency>
        <!-- Apache Commons Codec for MD5 -->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
            <version>1.16.0</version>
        </dependency>
        <!-- JTokkit - Java 版 tiktoken，精确 token 估算 -->
        <dependency>
            <groupId>com.knuddels</groupId>
            <artifactId>jtokkit</artifactId>
            <version>1.1.0</version>
        </dependency>
        <!-- juniversalchardet - Mozilla 通用编码检测库，支持 30+ 编码自动识别 -->
        <dependency>
            <groupId>com.github.albfernandez</groupId>
            <artifactId>juniversalchardet</artifactId>
            <version>2.5.0</version>
        </dependency>

        <!-- ==================== P2P 远程连接依赖 ==================== -->

        <!-- Netty - 高性能异步网络框架，TCP Server/Client -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-all</artifactId>
            <version>4.1.107.Final</version>
        </dependency>

        <!-- Protobuf - 高效二进制序列化，P2P 消息协议 -->
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>3.25.3</version>
        </dependency>

        <!-- ZXing - 二维码生成与解析（信令交换） -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.3</version>
        </dependency>

        <!-- BouncyCastle - TLS 自签名证书生成与 AES 加密 -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>

        <!-- ==================== ChatAttachment 附件解析依赖 ==================== -->

        <!-- PDFBox - PDF 解析 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.2</version>
        </dependency>

        <!-- POI - Word/Excel 解析 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <!-- ==================== MCP（Model Context Protocol）依赖 ==================== -->

        <!-- MCP Java SDK 核心：STDIO / JDK HttpClient(客户端) / Jakarta Servlet(服务端) 传输 -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-core</artifactId>
            <version>${mcp.version}</version>
        </dependency>
        <!-- MCP JSON 序列化 Jackson 2 绑定（与 Spring Boot 3.x 的 Jackson 2 兼容） -->
        <!-- ⚠️ 注意：禁止引入 mcp 聚合包（捆绑 Jackson 3），会导致序列化冲突 -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-json-jackson2</artifactId>
            <version>${mcp.version}</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                前端构建：自动编译两套 Vue3 前端（可使用 -DskipFrontend=true 跳过）

                  ① 经典版   frontend/     → src/main/resources/static/     （访问 /）
                  ② 新版 v3  frontend-v3/  → src/main/resources/v3-static/  （访问 /v3/）

                两套产物目录必须互相独立：经典版 vite 的 outDir 是 static/ 且带 emptyOutDir，
                每次构建都会清空整个 static，v3 若放在 static/v3/ 会被一起删掉
                （所以 v3 输出到 static 之外的 v3-static/，由后端 SpaConfig 用
                ResourceHandler 把 /v3/** 映射过去）。

                CI（.github/workflows/release.yml）走的就是这条链路，只跑
                `mvn clean package`，不会调 scripts/pack-v3.bat —— 这里漏配 v3，
                发布出来的安装包就会 /v3/ 404（曾经发生过一次，故此处显式配置）。
            -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>1.15.0</version>
                <configuration>
                    <!--
                        真正生效的跳过开关。此前缺失，导致注释里承诺的
                        `-DskipFrontend=true` 一直是空操作（打包照旧重建前端）。
                    -->
                    <skip>${skipFrontend}</skip>
                    <!--
                        node/npm 统一装到 ${project.basedir}/node，两套前端共用一份
                        （版本一致时后续 execution 直接跳过下载）。该目录已加入 .gitignore。
                    -->
                    <installDirectory>${project.basedir}</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install node and npm</id>
                        <goals><goal>install-node-and-npm</goal></goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <nodeVersion>v22.14.0</nodeVersion>
                            <npmVersion>10.9.2</npmVersion>
                            <workingDirectory>${project.basedir}/frontend</workingDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm install</id>
                        <goals><goal>npm</goal></goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>install</arguments>
                            <workingDirectory>${project.basedir}/frontend</workingDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>npm build</id>
                        <goals><goal>npm</goal></goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>run build</arguments>
                            <workingDirectory>${project.basedir}/frontend</workingDirectory>
                        </configuration>
                    </execution>

                    <!-- ============ 新版前端（frontend-v3，访问路径 /v3/）============ -->
                    <!--
                        产物由 frontend-v3/vite.config.ts 的 build.outDir 直接落到
                        src/main/resources/v3-static/，与经典版的 static/ 完全隔离。

                        不重复 install-node-and-npm：node/npm 已由上面的 execution 装到
                        ${project.basedir}/node，两套前端共用。

                        注意 execution id 不能与经典版重名，否则 Maven 会告警并只保留一个。
                    -->
                    <execution>
                        <id>v3 npm install</id>
                        <goals><goal>npm</goal></goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>install --no-audit --no-fund</arguments>
                            <workingDirectory>${project.basedir}/frontend-v3</workingDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>v3 npm build</id>
                        <goals><goal>npm</goal></goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>run build</arguments>
                            <workingDirectory>${project.basedir}/frontend-v3</workingDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
